{
  "name": "paperconvert",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A file converter that runs in the browser, built with PaperUI. Nothing is uploaded.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.prerender.config.ts && bun scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mileniumhq/paperui": "file:../../Paperboard/packages/paperui",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "heic-decode": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "solid-js": "^1.9.15",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "license": "MIT"
}
